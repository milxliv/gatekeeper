# GateKeeper Passwords
# GATEKEEPER_PASSWORD — front desk access (dashboard, check-in, pre-register)
# GATEKEEPER_ADMIN_PASSWORD — admin access (settings, badge branding, hosts CRUD)
# If only GATEKEEPER_PASSWORD is set, it grants admin access too.
GATEKEEPER_PASSWORD=changeme
GATEKEEPER_ADMIN_PASSWORD=adminpass

# Kiosk API secret — required for /api/kiosk/checkin endpoint
# Set this to protect the unauthenticated kiosk endpoint.
# Kiosk tablet must send X-Kiosk-Secret header with this value.
GATEKEEPER_KIOSK_SECRET=your_kiosk_secret_here

# GateKeeper Graph API Configuration
# Copy to .env (never commit to git)
#
# HOW TO GET THESE VALUES:
#   1. Azure Portal -> Azure Active Directory -> App registrations -> New registration
#   2. Name: "GateKeeper Calendar"
#   3. Supported account types: "Accounts in this organizational directory only"
#   4. No redirect URI needed (daemon app)
#
#   After creation:
#   5. Copy Application (client) ID -> GRAPH_CLIENT_ID
#   6. Copy Directory (tenant) ID   -> GRAPH_TENANT_ID
#   7. Certificates & secrets -> New client secret -> Copy value -> GRAPH_CLIENT_SECRET
#      (value only shown once)
#
#   API Permissions (Application permissions, NOT Delegated):
#   8. Microsoft Graph -> Calendars.ReadWrite
#      -> Grant admin consent (requires Global Admin)
#
#   Group ID:
#   9. Azure AD -> Groups -> find your O365 group -> Object ID -> GRAPH_GROUP_ID

GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your_client_secret_value_here
GRAPH_GROUP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_GROUP_EMAIL=engineering@wbbh.com

# Receptionist email — added as attendee on all visitor calendar events (optional)
RECEPTIONIST_EMAIL=frontdesk@wbbh.com

# GateKeeper SQLite database path
GATEKEEPER_DB=gatekeeper.db

# Port (default 3000)
GATEKEEPER_PORT=3006

# Photos directory
GATEKEEPER_PHOTOS=photos

# Log level: error | warn | info | debug | trace
RUST_LOG=info
